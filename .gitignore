# Estado local do Vagrant (contem chaves privadas - NUNCA versionar)
.vagrant/
*.log
ubuntu-*-console.log

# TP1: dados persistentes gerados em runtime: o diretorio e versionado, o conteudo nao.
tp1/data/dados_persistentes/*
!tp1/data/dados_persistentes/.gitkeep

# Ansible
*.retry

# TP2: backups gerados em runtime na VM 4 (o diretorio e versionado, o conteudo nao)
tp2/data_backup/*
!tp2/data_backup/.gitkeep

# Logs das execucoes de teste do TP2 sao evidencia e devem ser versionados
!tp2/docs/logs-testes/**

# TP2: a box e versionada em partes (tp2/box/parts); o arquivo .box remontado nao
tp2/box/*.box
