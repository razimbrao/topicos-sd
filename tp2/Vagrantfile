# TP2 - K3s + Proxy HA (Keepalived/Nginx) + ciclo de vida nao destrutivo.
#
# Ordem de definicao: bastion e a VM 1 da topologia, mas e definida por ultimo
# porque e o no de controle Ansible e precisa que as outras tres ja existam
# (e que suas chaves privadas estejam em .vagrant/machines) para provisiona-las.

#
# O Vagrant retoma as VMs uma por vez, nesta ordem. k3s-worker (banco + uma
# replica da API) e auxiliary (proxy BACKUP) vem primeiro para o servico voltar
# pelo VIP antes das demais terminarem de ser retomadas.

NODES = {
  "k3s-worker" => { ip: "192.168.56.30", cpus: 2, memory: 2048, vb: "dcc091a-vm3-k3s-worker" },
  "auxiliary"  => { ip: "192.168.56.40", cpus: 1, memory: 1024, vb: "dcc091a-vm4-auxiliary" },
  "k3s-server" => { ip: "192.168.56.20", cpus: 2, memory: 2048, vb: "dcc091a-vm2-k3s-server" },
}

require "digest"
require "fileutils"

# Box unica do TP2, versionada no proprio repositorio (tp2/box/parts) em partes
# de 90 MB. Ela ja traz pacotes, K3s airgap, kubectl e imagens de container
# (ver tp2/box/bake.sh), entao nem o Vagrant Cloud nem o provisionamento
# dependem de servicos externos.
BOX_DIR     = File.join(__dir__, "box")
BOX_VERSION = File.read(File.join(BOX_DIR, "VERSION")).strip
BOX_NAME    = "dcc091a-tp2-jammy-#{BOX_VERSION}"
BOX_FILE    = "tp2-jammy-#{BOX_VERSION}.box"

# Remonta o arquivo .box a partir das partes, so quando a box ainda nao foi
# registrada no Vagrant desta maquina (nas demais execucoes nao custa nada).
def tp2_box_url
  vagrant_home = ENV["VAGRANT_HOME"] || File.join(Dir.home, ".vagrant.d")
  return nil if Dir.exist?(File.join(vagrant_home, "boxes", BOX_NAME))

  parts = Dir.glob(File.join(BOX_DIR, "parts", "#{BOX_FILE}.[0-9][0-9][0-9]")).sort
  # Sem abort: comandos como status/destroy/halt precisam funcionar mesmo sem a box.
  if parts.empty?
    warn "AVISO: partes da box nao encontradas em #{BOX_DIR}/parts (rode box/build-box.sh)"
    return nil
  end

  out = File.join(__dir__, ".vagrant", "box", BOX_FILE)
  expected = File.read(File.join(BOX_DIR, "parts", "#{BOX_FILE}.sha256")).strip
  unless File.exist?(out) && Digest::SHA256.file(out).hexdigest == expected
    FileUtils.mkdir_p(File.dirname(out))
    puts "==> Montando #{BOX_FILE} a partir de #{parts.size} partes..."
    File.open(out, "wb") do |f|
      parts.each { |p| File.open(p, "rb") { |src| IO.copy_stream(src, f) } }
    end
    unless Digest::SHA256.file(out).hexdigest == expected
      File.delete(out)
      warn "AVISO: checksum da box nao confere; partes corrompidas em #{BOX_DIR}/parts"
      return nil
    end
  end
  "file:///" + File.expand_path(out).sub(%r{\A/}, "")
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX_NAME
  config.vm.box_url = tp2_box_url
  config.vm.box_check_update = false
  config.vm.boot_timeout = 900

  # Clones vinculados: o disco da box e importado uma unica vez e cada VM grava
  # apenas as diferencas, em vez de copiar o disco inteiro quatro vezes.
  config.vm.provider "virtualbox" do |v|
    v.linked_clone = true
  end

  NODES.each do |name, spec|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: spec[:ip]
      node.vm.provider "virtualbox" do |v|
        v.name   = spec[:vb]
        v.cpus   = spec[:cpus]
        v.memory = spec[:memory]
      end

      if name == "auxiliary"
        node.vm.synced_folder "./data_backup", "/var/lib/app_data",
          create: true,
          mount_options: ["dmode=777", "fmode=666"]
      end
    end
  end

  config.vm.define "bastion", primary: true do |b|
    b.vm.hostname = "bastion"
    b.vm.network "private_network", ip: "192.168.56.10"
    b.vm.provider "virtualbox" do |v|
      v.name   = "dcc091a-vm1-bastion"
      v.cpus   = 1
      v.memory = 1024
    end

    b.vm.synced_folder "./.vagrant/machines", "/home/vagrant/machines"
    b.vm.synced_folder "./ansible", "/ansible"
    b.vm.synced_folder "./k3s", "/k3s"
    b.vm.synced_folder "./app", "/app"

    b.vm.provision "shell", name: "bootstrap-ansible", inline: <<-SHELL
      set -e
      if ! command -v ansible-playbook >/dev/null; then
        apt-get update
        apt-get install -y software-properties-common
        add-apt-repository --yes --update ppa:ansible/ansible
        apt-get install -y ansible
      fi
      install -d -m 700 -o vagrant -g vagrant /home/vagrant/keys
      for vm in k3s-server k3s-worker auxiliary; do
        install -m 600 -o vagrant -g vagrant \
          /home/vagrant/machines/$vm/virtualbox/private_key /home/vagrant/keys/$vm
      done
    SHELL

    b.vm.provision "ansible_local" do |ansible|
      ansible.install           = false
      ansible.provisioning_path = "/ansible"
      ansible.config_file       = "/ansible/ansible.cfg"
      ansible.inventory_path    = "inventory/hosts.yml"
      ansible.playbook          = "site.yml"
      ansible.limit             = "all"
    end
  end
end
